# Local development only. Copy this file to .env before running Docker Compose or pnpm dev.
# These sample database credentials are not for shared or production environments.
# For Neon/production, set DATABASE_URL in the deployment secret store; never reuse these local values.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
POSTGRES_DB=athar_dev
POSTGRES_USER=athar
POSTGRES_PASSWORD=athar_local_only
DATABASE_URL=postgresql://athar:athar_local_only@127.0.0.1:5432/athar_dev
# Server-side web-to-API base URL; never expose a database URL to the web app.
ATHAR_API_URL=http://127.0.0.1:4000/api/v1
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
