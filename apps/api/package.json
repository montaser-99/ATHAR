{
  "name": "@athar/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "corepack pnpm --filter @athar/contracts build && nest start --watch",
    "build": "corepack pnpm --filter @athar/contracts build && nest build",
    "start": "node dist/main.js",
    "test:env": "corepack pnpm build && node --test test/env.test.mjs",
    "test:directory": "corepack pnpm build && node --test test/directory-query.test.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "corepack pnpm build && node dist/platform/database/seed.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@athar/contracts": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
